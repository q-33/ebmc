<Project Sdk="Microsoft.NET.Sdk">

	<!--
		On-screen smoke test for the Mac host (Plan C, step C1 spike). Starts the real application in-process on a
		throwaway data folder (EBMC_DATA_DIR), drives it by widget name through agg-sharp's AutomationRunner and saves
		a screenshot after each step. Run it with Tools/macOS/ui-smoke.sh (Debug build: in Release the UI thread
		swallows exceptions). Not part of the EBMC.Tests run.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>EBMC.UiSmoke</RootNamespace>
		<IsPackable>false</IsPackable>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\MatterControl.CrossPlatform\MatterControl.CrossPlatform.csproj" />
		<ProjectReference Include="..\..\Submodules\agg-sharp\GuiAutomation\GuiAutomation.csproj" />
	</ItemGroup>

</Project>
