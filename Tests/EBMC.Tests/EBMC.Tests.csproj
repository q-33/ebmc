<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>EBMC.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compile the OctoPrint client sources directly so the tests do not depend on the app's other projects -->
		<Compile Include="..\..\MatterControl.Printing\OctoPrint\*.cs" Link="OctoPrint\%(Filename)%(Extension)" />
		<!-- The wording and warning/error decision for parts outside the printable area -->
		<Compile Include="..\..\MatterControl.Printing\Settings\PartsOutsideBedMessages.cs" Link="Settings\%(Filename)%(Extension)" />
		<!-- The club maintainer lock: which settings are locked, the PIN hash and the wording. SettingsKey and
		     SliceSettingsLayouts have no dependencies, so the rule is tested against the real layouts -->
		<Compile Include="..\..\MatterControl.Printing\Settings\SettingsKey.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\SliceSettingsLayouts.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\SettingsLock.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\MaintainerPin.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\MaintainerMessages.cs" Link="Settings\%(Filename)%(Extension)" />
		<!-- The shapes palette's catalog (families, members, tabs, size chips) and click placement rule; no UI dependencies -->
		<Compile Include="..\..\MatterControlLib\PartPreviewWindow\ShapesPalette\PaletteCatalog.cs" Link="ShapesPalette\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControlLib\PartPreviewWindow\ShapesPalette\PalettePlacement.cs" Link="ShapesPalette\%(Filename)%(Extension)" />
		<!-- The locked-theme rule (OemSettings.LockedThemeSet) -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\Themes\ThemeLock.cs" Link="Themes\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
	</ItemGroup>

</Project>
