<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>EBMC.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compile the OctoPrint client sources directly so the tests do not depend on the app's other projects -->
		<Compile Include="..\..\MatterControl.Printing\OctoPrint\*.cs" Link="OctoPrint\%(Filename)%(Extension)" />
		<!-- The wording and warning/error decision for parts outside the printable area -->
		<Compile Include="..\..\MatterControl.Printing\Settings\PartsOutsideBedMessages.cs" Link="Settings\%(Filename)%(Extension)" />
		<!-- The club maintainer lock: which settings are locked, the PIN hash and the wording. SettingsKey and
		     SliceSettingsLayouts have no dependencies, so the rule is tested against the real layouts -->
		<Compile Include="..\..\MatterControl.Printing\Settings\SettingsKey.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\SliceSettingsLayouts.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\SettingsLock.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\MaintainerPin.cs" Link="Settings\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControl.Printing\Settings\MaintainerMessages.cs" Link="Settings\%(Filename)%(Extension)" />
		<!-- The Simple · Advanced mode rules (default, slice-settings detail mapping); used by the palette catalog too -->
		<Compile Include="..\..\MatterControl.Printing\Settings\UiMode.cs" Link="Settings\%(Filename)%(Extension)" />
		<!-- The shapes palette's catalog (families, members, tabs, size chips) and click placement rule; no UI dependencies -->
		<Compile Include="..\..\MatterControlLib\PartPreviewWindow\ShapesPalette\PaletteCatalog.cs" Link="ShapesPalette\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControlLib\PartPreviewWindow\ShapesPalette\PalettePlacement.cs" Link="ShapesPalette\%(Filename)%(Extension)" />
		<!-- The shortcut wording in hints and menus (Cmd/Option on a Mac, "Ctrl + P" notation) -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\KeyHintRules.cs" Link="ApplicationView\%(Filename)%(Extension)" />
		<!-- The club dialog template and menu rules (Enter default, footer order, menu descriptions, toasts); no UI dependencies -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\ClubUi\Rules\*.cs" Link="ClubUi\%(Filename)%(Extension)" />
		<!-- The keyboard shortcuts sheet's table (checked against the handlers in Application.cs and View3DWidget.cs) -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\ShortcutTable.cs" Link="ApplicationView\%(Filename)%(Extension)" />
		<!-- When the Simple · Advanced switch waits, and its hint -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\UiModeBusyRules.cs" Link="ApplicationView\%(Filename)%(Extension)" />
		<!-- The locked-theme rule (OemSettings.LockedThemeSet) -->
		<Compile Include="..\..\MatterControlLib\ApplicationView\Themes\ThemeLock.cs" Link="Themes\%(Filename)%(Extension)" />
		<!-- Design-side rules: duplicate placement, text size in mm, subtract's hole default, model size prompt and the wording -->
		<Compile Include="..\..\MatterControlLib\DesignTools\EBMC\*.cs" Link="DesignTools\%(Filename)%(Extension)" />
		<!-- Exact solids: the rules (edge picking, limits, messages, mesh clean-up), the kernel bindings and the builders.
		     None of these use agg-sharp or the GUI; the Object3D classes in the same folder are not linked -->
		<Compile Include="..\..\MatterControlLib\DesignTools\Solid\SolidRules.cs" Link="Solid\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControlLib\DesignTools\Solid\EbmcOcct.cs" Link="Solid\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControlLib\DesignTools\Solid\SolidKernel.cs" Link="Solid\%(Filename)%(Extension)" />
		<Compile Include="..\..\MatterControlLib\DesignTools\Solid\SolidBuilders.cs" Link="Solid\%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- The solid kernel, when native/occt/build.sh has staged it for this machine; the kernel-backed tests are
	     skipped (Assert.Ignore) when it is absent -->
	<PropertyGroup>
		<EbmcOcctStaged>$(MSBuildThisFileDirectory)..\..\native\occt\dist\osx-arm64\libebmc_occt.dylib</EbmcOcctStaged>
	</PropertyGroup>
	<ItemGroup Condition="Exists('$(EbmcOcctStaged)')">
		<None Include="$(EbmcOcctStaged)" Link="libebmc_occt.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
	</ItemGroup>

</Project>
