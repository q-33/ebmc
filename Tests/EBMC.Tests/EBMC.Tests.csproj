<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>EBMC.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compile the OctoPrint client sources directly so the tests do not depend on the app's other projects -->
		<Compile Include="..\..\MatterControl.Printing\OctoPrint\*.cs" Link="OctoPrint\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
	</ItemGroup>

</Project>
